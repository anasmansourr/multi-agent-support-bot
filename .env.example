# Copy this file to ".env" (PowerShell: Copy-Item .env.example .env), then edit .env.
# NEVER commit ".env", paste it in screenshots, or send it to anyone.
GROQ_API_KEY=your_key_here

# Optional: override the default Groq model (see: python -m src.llm.providers --list)
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: local fallback model served by Ollama (https://ollama.com)
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434
